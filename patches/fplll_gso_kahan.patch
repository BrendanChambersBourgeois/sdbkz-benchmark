From 1cbf2fd25d72a9e8552b285da0f5faf1fc4f895b Mon Sep 17 00:00:00 2001
From: BrendanChambersBourgeois <brendanchambersbou@gmail.com>
Date: Fri, 8 May 2026 13:24:01 +1000
Subject: [PATCH] gso: Kahan-compensated subtraction in update_gso_row

Compensated (Kahan) accumulation of the projection sum in update_gso_row,
reducing cancellation error in r(i, i) on near-degenerate bases. The residual
is c = (t - ftmp1) + y -- the low-order bits lost in t = ftmp1 - y -- carried
and reinjected on the next iteration. Scratch (kahan_c/kahan_y/kahan_t) are
member variables to avoid a per-call FT construct/destruct (a heap allocation
for the MPFR backend).

Adds tests/test_gso_kahan: two near-degenerate bases on which the plain
subtraction leaves a nonpositive r(i, i) (min r = -0.625 and -2.125) with the
double backend; the compensated form keeps every GS norm positive. The
fixtures also hold under FMA contraction of the mul/sub pair.
---
 fplll/gso_interface.cpp  |  10 +++-
 fplll/gso_interface.h    |   3 ++
 tests/Makefile.am        |   3 +-
 tests/test_gso_kahan.cpp | 106 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 120 insertions(+), 2 deletions(-)
 create mode 100644 tests/test_gso_kahan.cpp

diff --git a/fplll/gso_interface.cpp b/fplll/gso_interface.cpp
index c981a777..5d2c1eee 100644
--- a/fplll/gso_interface.cpp
+++ b/fplll/gso_interface.cpp
@@ -144,10 +144,18 @@ template <class ZT, class FT> bool MatGSOInterface<ZT, FT>::update_gso_row(int i
   {
     get_gram(ftmp1, i, j);
     FPLLL_DEBUG_CHECK(j == i || gso_valid_cols[j] >= j);
+    // ftmp1 := <b_i, b_j> - sum_{k<j} mu(j,k) * r(i,k), Kahan-compensated.
+    // The plain subtraction cancels catastrophically at j == i and can leave a
+    // negative r(i,i) -- the squared GS norm -- on near-degenerate bases.
+    kahan_c = 0.0;
     for (int k = 0; k < j; k++)
     {
       ftmp2.mul(mu(j, k), r(i, k));
-      ftmp1.sub(ftmp1, ftmp2);
+      kahan_y.add(ftmp2, kahan_c);
+      kahan_t.sub(ftmp1, kahan_y);
+      kahan_c.sub(kahan_t, ftmp1);    // c = t - ftmp1  (rounding error lost in t)
+      kahan_c.add(kahan_c, kahan_y);  // c += y  (residual reinjected next iteration)
+      ftmp1 = kahan_t;
     }
     r(i, j) = ftmp1;
     if (i > j)
diff --git a/fplll/gso_interface.h b/fplll/gso_interface.h
index 66779922..59905c85 100644
--- a/fplll/gso_interface.h
+++ b/fplll/gso_interface.h
@@ -609,6 +609,9 @@ protected:
 
   /* Used by update_gso_row (+ update_gso), get_max_mu_exp and row_addmul_we. */
   FT ftmp1, ftmp2;
+  /* Kahan scratch for update_gso_row's compensated subtraction; members not
+     locals to spare a per-call FT construct/destruct (a heap alloc for MPFR). */
+  FT kahan_c, kahan_y, kahan_t;
   /* Used by row_add, row_sub, row_addmul_si_2exp, row_addmul_2exp and
      indirectly by row_addmul. */
   ZT ztmp1;
diff --git a/tests/Makefile.am b/tests/Makefile.am
index 95b97d4c..dd76fea1 100755
--- a/tests/Makefile.am
+++ b/tests/Makefile.am
@@ -43,7 +43,7 @@ AM_CPPFLAGS = -I$(TOPSRCDIR) -I$(TOPSRCDIR)/fplll -I$(TOPBUILDDIR) -DTESTDATADIR
 STAGEDIR := $(realpath -s $(TOPBUILDDIR)/.libs)
 AM_LDFLAGS = -L$(STAGEDIR) -Wl,-rpath,$(STAGEDIR) -lfplll -no-install $(LIBQD_LIBS)
 
-TESTS = test_nr test_lll test_enum test_cvp test_svp test_bkz test_pruner test_gso test_lll_gram test_hlll test_svp_gram test_bkz_gram test_counter test_babai test_ceil
+TESTS = test_nr test_lll test_enum test_cvp test_svp test_bkz test_pruner test_gso test_gso_kahan test_lll_gram test_hlll test_svp_gram test_bkz_gram test_counter test_babai test_ceil
 
 test_pruner_LDADD=$(LIBQD_LIBS)
 
@@ -55,6 +55,7 @@ test_cvp_SOURCES = test_cvp.cpp
 test_bkz_SOURCES = test_bkz.cpp
 test_pruner_SOURCES = test_pruner.cpp
 test_gso_SOURCES = test_gso.cpp
+test_gso_kahan_SOURCES = test_gso_kahan.cpp
 test_lll_gram_SOURCES = test_lll_gram.cpp
 test_hlll_SOURCES = test_hlll.cpp
 test_svp_gram_SOURCES = test_svp_gram.cpp
diff --git a/tests/test_gso_kahan.cpp b/tests/test_gso_kahan.cpp
new file mode 100644
index 00000000..7c66096b
--- /dev/null
+++ b/tests/test_gso_kahan.cpp
@@ -0,0 +1,106 @@
