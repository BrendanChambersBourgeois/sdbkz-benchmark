+#include "test_utils.h"
+#include <fplll/gso.h>
+#include <fplll/gso_interface.h>
+#include <fplll/nr/matrix.h>
+
+using namespace std;
+using namespace fplll;
+
+/* Regression fixtures for the Kahan-compensated subtraction in update_gso_row.
+   Each basis has a near-dependent last row whose Gram-Schmidt residual r(i, i)
+   is O(1) while <b_i, b_i> is ~10^15: forming r(i, i) subtracts two ~10^15
+   double quantities. With the plain subtraction the double backend loses the
+   residual and reports a nonpositive r(i, i) (min r = -0.625 for the 10x10 and
+   -2.125 for the 13x13 case); the compensated subtraction keeps every diagonal
+   positive. The fixtures were selected so both verdicts also hold when the
+   mul/sub pair is contracted to an FMA, so the test is stable across IEEE-754
+   builds and codegen. */
+static const long BASIS_10[10][10] = {
+    {10000000, 2, 0, 0, 1, 0, 0, -2, 0, -1},
+    {2, 84, -2, 1, 2, -1, 1, -2, 1, -1},
+    {0, -1, 10000000, 0, -2, 0, 0, -2, 0, 0},
+    {0, 1, 0, 270, 1, 1, 1, 0, 1, 1},
+    {1, 0, -1, 2, 10000000, -2, -2, 2, 2, -2},
+    {2, -2, 1, 0, -2, 10000000, 0, 1, -1, 0},
+    {-2, 1, 1, 0, -2, -2, 143, 0, 1, 0},
+    {1, 2, 2, 2, -1, -1, 1, 232, -2, -1},
+    {-1, -2, 2, 1, 0, 2, -1, 0, 10000000, 0},
+    {10000003, 336, 40000007, 1096, 40000002, 39999986, 281, 928, 20000004, -12}};
+
+static const long BASIS_13[13][13] = {{10000000, -2, -1, -1, -1, -1, -2, -2, 0, 1, -2, -2, -1},
+                                      {0, 169, 2, 2, -2, 2, 2, 1, 0, -1, 2, 1, 0},
+                                      {-1, 2, 120, 2, -1, 2, -2, 0, 1, 1, 1, 1, 2},
+                                      {0, -1, 2, 10000000, -1, 1, 0, 2, 1, 1, 0, 1, 0},
+                                      {-1, 2, -1, 0, 370, 1, 2, 1, 1, -1, 0, -1, -2},
+                                      {1, -2, 0, 0, 0, 383, -1, 0, 2, 0, 1, 1, -1},
+                                      {1, 0, -2, 0, 1, -2, 10000000, 0, -2, 0, 0, 1, 1},
+                                      {1, 0, 0, 1, -2, 0, -2, 10000000, 0, -1, 0, 1, -2},
+                                      {-1, 2, 1, 0, -1, -2, -2, -2, 10000000, -2, -2, 0, -2},
+                                      {-1, 0, -1, -1, 2, -1, -2, -2, 2, 10000000, 0, -2, 0},
+                                      {0, -1, 1, 2, 2, -2, 2, 1, -1, -1, 10000000, 1, 2},
+                                      {-1, 1, 0, -1, 0, 0, -1, 2, 2, 0, 2, 10000000, 1},
+                                      {39999999, 351, 238, 40000010, 359, 1535, 39999981, 19999996,
+                                       40000015, 19999998, 30000010, 30000007, -6}};
+
+// Assert that every diagonal r(i, i) of the GSO of A is strictly positive.
+template <class ZT, class FT> int check_positive_diagonal(ZZ_mat<ZT> &A)
+{
+  int status = 0;
+  ZZ_mat<ZT> U;
+  ZZ_mat<ZT> UT;
+  MatGSO<Z_NR<ZT>, FP_NR<FT>> M(A, U, UT, GSO_INT_GRAM);
+  M.update_gso();
+
+  FP_NR<FT> r;
+  for (int i = 0; i < A.get_rows(); i++)
+  {
+    M.get_r(r, i, i);
+    if (r.cmp(0.0) <= 0)
+    {
+      cerr << "r(" << i << ", " << i << ") = " << r << " must be positive." << endl;
+      status = 1;
+    }
+  }
+  return status;
+}
+
+template <class ZT, class FT, int N> int test_fixture(const long basis[N][N])
+{
+  ZZ_mat<ZT> A;
+  A.resize(N, N);
+  for (int i = 0; i < N; i++)
+    for (int j = 0; j < N; j++)
+      A[i][j] = basis[i][j];
+  return check_positive_diagonal<ZT, FT>(A);
+}
+
+int main(int /*argc*/, char ** /*argv*/)
+{
+  int status = 0;
+
+  // double: the backend the compensated subtraction protects.
+  status |= test_fixture<mpz_t, double, 10>(BASIS_10);
+  status |= test_fixture<mpz_t, double, 13>(BASIS_13);
+
+  // mpfr must stay positive too (the loop composes with any FT).
+  status |= test_fixture<mpz_t, mpfr_t, 13>(BASIS_13);
+
+  if (status == 0)
+    cerr << "All tests passed." << endl;
+  return status;
+}
