+// Reject-on-overflow (2026-10-13, applied on top of the INC-63 tolerant patch).
+// Coefficients x are int16 (ZT), so addsub_vec wraps a sum outside
+// [-32767, 32767] and the stored vector is no longer the one the length test
+// accepted. Refuse such a reduction instead (callers treat it as no
+// reduction); count rejections and report the count at powers of two.
+static std::atomic<unsigned long> g_overflow_rejects{0};
+static inline bool zt_sum_overflows(std::array<ZT,MAX_SIEVING_DIM> const &a,
+                                    std::array<ZT,MAX_SIEVING_DIM> const &b, int sign, unsigned int n)
+{
+  for (unsigned int i = 0; i < n; ++i)
+  {
+    long const v = (long)a[i] + (long)sign * (long)b[i];
+    if (UNLIKELY(v > 32767 || v < -32767))
+    {
+      unsigned long const k = ++g_overflow_rejects;
+      if ((k & (k - 1)) == 0)
+        std::fprintf(stderr, "g6k reduce_in_db: rejected int16-overflow reduction #%lu (n=%u)\n", k, n);
+      return true;
+    }
+  }
+  return false;
+}
