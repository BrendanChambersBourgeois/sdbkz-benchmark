# G6K determinism-locked variant — source-builds fplll → fpylll → G6K
# (General Sieve Kernel) for a SEPARATE, single-threaded, SHA-lockable
# sieving engine alongside the fplll BKZ path. This image NEVER replaces
# the main Dockerfile's fplll path; it stands beside it (ADR-005).
#
# Phase 0 recon verdict (2026-06-04, settled): G6K is byte-reproducible
# ONLY at threads=1. Multi-threaded sieving is nondeterministic even with
# every RNG seed pinned — the nondeterminism is the order of concurrent
# vector insertions into the sieve database (a thread-scheduling race),
# which no seed controls. Contract is therefore non-negotiable:
#     threads=1  +  FPLLL.set_random_seed(S)  +  SieverParams["seed"]=S
#     +  same machine/build  +  default sieve params.
# threads>1 is REJECTED by g6k_probe.py / verify_g6k.sh, not merely warned.
#
# Digest-pinned base per ADR-004; see Dockerfile (main) for the digest
# resolution provenance (resolved 2026-05-14 from Docker Hub v2 API; tag
# python:3.12.3-bookworm last_updated 2024-05-14T18:08:59Z).
FROM python:3.12.3-bookworm@sha256:25dee7f137aa44c4962d21346385737eb81954b6f06f519fcc348b67f6483d3c

# -- Reproducible compilation target ----------------------------------------
# -march=x86-64-v2 (NOT -march=native). -march=native bakes the build host's
# exact ISA into the binary and breaks cross-machine bit-identity — the whole
# point of the determinism gate. x86-64-v2 (SSE4.2/POPCNT, ~Nehalem+) is the
# universal x86-64 floor: it produces a binary that is byte-identical on every
# machine AND runs on every GitHub-hosted runner (INC-55: the fleet drifted to
# include v2-only runners, and an AVX2/FMA binary SIGILLs on `import
# g6k.siever` there).
#
# CRITICAL (INC-55, 2026-08-14): g6k's own `./configure` defaults to
# `--enable-native`, which detects the build host's SIMD and APPENDS AVX2/FMA
# flags on top of our CXXFLAGS — silently overriding the v2 target. Setting
# these ENV vars alone does nothing for the g6k siever (disassembly showed
# AVX2 `ymm`/`vfmadd` in the "v2" .so). The g6k configure below MUST pass
# `--disable-native` for this v2 target to actually take effect. fplll/fpylll
# honour the ENV directly.
#
# WARNING — this determines the g6k determinism reference SHA. Any change to
# the effective target (e.g. adding/removing --disable-native) changes the
# binary, so the reference MUST be re-captured (run scripts/g6k_probe.py in the
# freshly built image, write the SHAs into results/g6k_seed_manifest.json)
# before the HARD byte-identity gate can pass.
ENV CFLAGS="-O3 -march=x86-64-v2 -Wp,-U_FORTIFY_SOURCE" \
    CXXFLAGS="-O3 -march=x86-64-v2 -Wp,-U_FORTIFY_SOURCE"

# make -j parallelism. Defaults to all cores; override at build time with
# --build-arg BUILD_JOBS=4 to coexist with other CPU-heavy work on the
# build host (e.g. a live sweep) without starving it.
ARG BUILD_JOBS=

# Apt pinned via snapshot.debian.org (ADR-004) — frozen Debian archive at
# 20240614T000000Z so the libgmp/libmpfr headers match the runtime libs
# the base-image digest bakes in. autoconf/automake/libtool needed for
# fplll ./autogen.sh; git to clone pinned upstream commits.
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20240614T000000Z/\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/20240614T000000Z/\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        > /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        libmpfr-dev \
        libgmp-dev \
        libqd-dev \
        build-essential \
        autoconf \
        automake \
        libtool \
        libtool-bin \
        pkg-config \
        git \
    && rm -rf /var/lib/apt/lists/*

# -- Build fplll (master @ 1987472) from source -----------------------------
# Phase 0-pinned commit; produces libfplll.so.9. --disable-static keeps the
# image small; ldconfig so fpylll + g6k link against /usr/local/lib.
ARG FPLLL_COMMIT=1987472
RUN git clone https://github.com/fplll/fplll.git /tmp/fplll \
    && cd /tmp/fplll \
    && git checkout ${FPLLL_COMMIT} \
    && ./autogen.sh \
    && ./configure --prefix=/usr/local --disable-static \
    && make -j${BUILD_JOBS:-$(nproc)} \
    && make install \
    && ldconfig \
    && rm -rf /tmp/fplll

# -- Python build deps ------------------------------------------------------
# Pinned to the main image's numerical-core versions where they overlap
# (numpy/scipy/cysignals) so the g6k path shares one ABI surface with the
# fplll path. Cython>=3 required by both fpylll and g6k. six is a g6k
# runtime import (g6k/algorithms/workout.py). No matplotlib/figure deps:
# this image only sieves + emits hashes, never renders.
RUN pip install --no-cache-dir \
        "Cython>=3.0,<3.1" \
        cysignals==1.12.6 \
        numpy==2.4.4 \
        scipy==1.17.1 \
        six==1.17.0 \
        pytest==9.0.3

# -- Build fpylll (@ e25ade8, reports 0.6.4) from source --------------------
# Phase 0-pinned commit. Built from source (NOT the PyPI wheel) because the
# wheel bundles its own fplll + ships no headers, so G6K's C++ kernel could
# not link against it. --no-build-isolation so the build sees the Cython +
# numpy + cysignals pinned above and the system fplll headers in /usr/local.
ARG FPYLLL_COMMIT=e25ade8
RUN git clone https://github.com/fplll/fpylll.git /tmp/fpylll \
    && cd /tmp/fpylll \
    && git checkout ${FPYLLL_COMMIT} \
    && pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /tmp/fpylll

# -- Build G6K (@ c71e084) from source --------------------------------------
# Phase 0-pinned commit (2025-11-09 master). pip install --no-build-isolation
# so g6k's setup.py finds the installed fpylll (it imports fpylll to resolve
# include paths) + Cython. Installs the g6k package + compiled siever exts
# into site-packages so `import g6k` works with no PYTHONPATH gymnastics.
#
# G6K_MAX_SIEVING_DIM: kernel/siever.h caps the sieving context at
# MAX_SIEVING_DIM (default 128). g6k's setup.py runs ./configure itself
# (with no arguments) when no Makefile exists, so env CXXFLAGS defines
# are NOT honoured — the knob is configure's --with-max-sieving-dim
# (configure.ac AC_ARG_WITH), which must be run BEFORE pip install.
# Our NTRU lattices have dim=2n; n>=101 (dim 202) exceeds the default
# cap and G6K refuses to sieve. Build with
# --build-arg G6K_MAX_SIEVING_DIM=256 for an n>=101-capable image
# (larger fixed-size vector arrays; byte-identity vs the 128-build must
# be re-gated — verify_g6k.sh against the captured reference decides
# whether the reference SHAs carry over).
# INC-63 (2026-08-31): kernel/sieving.cpp gauss_sieve asserted strict length
# improvement after an in-db reduction, but gauss_no_upd_reduce_in_db validates
# only the PREDICTED length and stores the exactly RECOMPUTED one, which can
# round to >= the pre-reduction length; every beta=60 NTRU seed (and 2 of ~1300
# beta=50 seeds) died on that assert. The patch replaces the assert with the
# NDEBUG-equivalent tolerant swap plus a counter + rate-limited stderr report
# (bgj1/bdgl already re-validate after recompute; gauss is the outlier).
# Byte-identity: any completed seed never took the failing branch (it would
# have aborted), so reference SHAs are expected to carry over — but the
# binary changes, so verify_g6k.sh against the captured reference is the
# gate that decides, per the warning above.
ARG G6K_COMMIT=c71e084
ARG G6K_MAX_SIEVING_DIM=128
COPY patches/g6k_gauss_nonimproving_tolerant.patch /tmp/g6k_gauss_nonimproving_tolerant.patch
RUN git clone https://github.com/fplll/g6k.git /tmp/g6k \
    && cd /tmp/g6k \
    && git checkout ${G6K_COMMIT} \
    && git apply --verbose /tmp/g6k_gauss_nonimproving_tolerant.patch \
    && autoreconf -i \
    && ./configure --disable-native --with-max-sieving-dim=${G6K_MAX_SIEVING_DIM} \
    && pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /tmp/g6k

# Non-root runtime — match host UID/GID so bind-mounted volumes don't
# produce root-owned host files (Incident #32 pattern; backlog
# backlog/2026-04-20_v3_dockerfile_scope.md §8).
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if ! getent group ${HOST_GID} >/dev/null; then \
        groupadd -g ${HOST_GID} runner; \
    fi && \
    if ! getent passwd ${HOST_UID} >/dev/null; then \
        useradd --no-log-init -u ${HOST_UID} -g ${HOST_GID} -m runner; \
    fi

WORKDIR /experiment
COPY --chown=${HOST_UID}:${HOST_GID} scripts/ scripts/
# Ship the g6k manifest so the default CMD (verify_g6k.sh) reads its
# reference SHA without a host bind-mount. SEPARATE from the fplll
# seed_manifest.json the main image ships (ADR-005).
COPY --chown=${HOST_UID}:${HOST_GID} results/g6k_seed_manifest.json results/
RUN chown -R ${HOST_UID}:${HOST_GID} /experiment

# Build-time sanity: confirm the engine imports and report the linked
# fplll. Still root so /usr/local/lib reads succeed without group fuss.
RUN python3 -c "import g6k; from g6k import Siever, SieverParams; import fpylll; print('g6k OK; fpylll', fpylll.__version__)" \
    && (strings /usr/local/lib/libfplll.so* 2>/dev/null | grep -oE 'fplll-[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)

USER ${HOST_UID}:${HOST_GID}

# Default: run the single-threaded determinism verify (SHA gate).
CMD ["bash", "scripts/verify_g6k.sh"]
