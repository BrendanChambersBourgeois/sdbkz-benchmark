# G6K (General Sieve Kernel) image: source-built fplll -> fpylll -> G6K as a
# separate, single-threaded, SHA-locked sieving engine beside the fplll path.
# G6K is byte-reproducible only at threads=1 (concurrent sieve-db insertion
# order is a scheduling race no seed controls); g6k_probe.py and verify_g6k.sh
# reject threads>1.
FROM python:3.12.3-bookworm@sha256:25dee7f137aa44c4962d21346385737eb81954b6f06f519fcc348b67f6483d3c

# -march=x86-64-v2, not native: a native build bakes the host ISA into the
# binary and breaks cross-machine bit-identity (AVX2 builds SIGILL on v2-only
# CI runners). g6k's ./configure defaults to --enable-native and appends AVX2
# flags on top of CXXFLAGS, so the configure call below must pass
# --disable-native. Any change to the effective target changes the
# determinism reference SHA in results/g6k_seed_manifest.json.
ENV CFLAGS="-O3 -march=x86-64-v2 -Wp,-U_FORTIFY_SOURCE" \
    CXXFLAGS="-O3 -march=x86-64-v2 -Wp,-U_FORTIFY_SOURCE"

# make -j parallelism; default all cores.
ARG BUILD_JOBS=

# Apt pinned to a dated snapshot.debian.org archive so headers match the
# runtime libs baked into the base-image digest.
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20240614T000000Z/\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/20240614T000000Z/\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        > /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        libmpfr-dev \
        libgmp-dev \
        libqd-dev \
        build-essential \
        autoconf \
        automake \
        libtool \
        libtool-bin \
        pkg-config \
        git \
    && rm -rf /var/lib/apt/lists/*

# fplll from source (libfplll.so.9).
ARG FPLLL_COMMIT=1987472
RUN git clone https://github.com/fplll/fplll.git /tmp/fplll \
    && cd /tmp/fplll \
    && git checkout ${FPLLL_COMMIT} \
    && ./autogen.sh \
    && ./configure --prefix=/usr/local --disable-static \
    && make -j${BUILD_JOBS:-$(nproc)} \
    && make install \
    && ldconfig \
    && rm -rf /tmp/fplll

# Python build deps, pinned to the main image's versions where they overlap.
RUN pip install --no-cache-dir \
        "Cython>=3.0,<3.1" \
        cysignals==1.12.6 \
        numpy==2.4.4 \
        scipy==1.17.1 \
        six==1.17.0 \
        pytest==9.0.3

# fpylll from source (reports 0.6.4): the PyPI wheel bundles its own fplll
# and ships no headers, so the G6K kernel could not link against it.
ARG FPYLLL_COMMIT=e25ade8
RUN git clone https://github.com/fplll/fpylll.git /tmp/fpylll \
    && cd /tmp/fpylll \
    && git checkout ${FPYLLL_COMMIT} \
    && pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /tmp/fpylll

# G6K from source. G6K_MAX_SIEVING_DIM caps the sieving context (default 128;
# NTRU lattices have dim 2n, so n>=101 needs 256 and n>=129 needs 384); it is
# a configure knob, so configure runs before pip install.
# APPLY_INC63 (1 = apply patches/g6k_gauss_nonimproving_tolerant.patch, the
# default; 0 = stock gauss_sieve assert) and REJECT_OVERFLOW (1 = also apply
# patches/g6k_gauss_reject_overflow.patch, needs APPLY_INC63=1) select the
# gauss_sieve variant. Image tags (docs/images.md):
#   sdbkz-g6k:dim384        G6K_MAX_SIEVING_DIM=384 APPLY_INC63=0
#   sdbkz-g6k:dim384-inc63  G6K_MAX_SIEVING_DIM=384 APPLY_INC63=1
#   sdbkz-g6k:dim384-reject G6K_MAX_SIEVING_DIM=384 APPLY_INC63=1 REJECT_OVERFLOW=1
ARG G6K_COMMIT=c71e084
ARG G6K_MAX_SIEVING_DIM=128
ARG APPLY_INC63=1
ARG REJECT_OVERFLOW=0
COPY patches/g6k_gauss_nonimproving_tolerant.patch /tmp/g6k_gauss_nonimproving_tolerant.patch
COPY patches/g6k_gauss_reject_overflow.patch /tmp/g6k_gauss_reject_overflow.patch
RUN git clone https://github.com/fplll/g6k.git /tmp/g6k \
    && cd /tmp/g6k \
    && git checkout ${G6K_COMMIT} \
    && case "${APPLY_INC63}" in \
         1) git apply --verbose /tmp/g6k_gauss_nonimproving_tolerant.patch ;; \
         0) echo "APPLY_INC63=0: INC-63 gauss_sieve patch NOT applied" ;; \
         *) echo "APPLY_INC63 must be 0 or 1, got '${APPLY_INC63}'" >&2; exit 1 ;; \
       esac \
    && case "${REJECT_OVERFLOW}" in \
         1) [ "${APPLY_INC63}" = 1 ] || { echo "REJECT_OVERFLOW=1 needs APPLY_INC63=1" >&2; exit 1; } \
            && git apply --verbose /tmp/g6k_gauss_reject_overflow.patch ;; \
         0) ;; \
         *) echo "REJECT_OVERFLOW must be 0 or 1, got '${REJECT_OVERFLOW}'" >&2; exit 1 ;; \
       esac \
    && autoreconf -i \
    && ./configure --disable-native --with-max-sieving-dim=${G6K_MAX_SIEVING_DIM} \
    && pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /tmp/g6k

# Non-root runtime matching the host UID/GID so bind mounts stay host-owned.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if ! getent group ${HOST_GID} >/dev/null; then \
        groupadd -g ${HOST_GID} runner; \
    fi && \
    if ! getent passwd ${HOST_UID} >/dev/null; then \
        useradd --no-log-init -u ${HOST_UID} -g ${HOST_GID} -m runner; \
    fi

WORKDIR /experiment
COPY --chown=${HOST_UID}:${HOST_GID} scripts/ scripts/
# The g6k manifest (separate from the fplll seed_manifest.json) so the
# default CMD reads its reference SHA without a bind mount.
COPY --chown=${HOST_UID}:${HOST_GID} results/g6k_seed_manifest.json results/
RUN chown -R ${HOST_UID}:${HOST_GID} /experiment

RUN python3 -c "import g6k; from g6k import Siever, SieverParams; import fpylll; print('g6k OK; fpylll', fpylll.__version__)" \
    && (strings /usr/local/lib/libfplll.so* 2>/dev/null | grep -oE 'fplll-[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)

USER ${HOST_UID}:${HOST_GID}

CMD ["bash", "scripts/verify_g6k.sh"]
