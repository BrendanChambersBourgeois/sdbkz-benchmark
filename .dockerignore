# Big raw data — reproduced from scratch inside the container via verify.sh
# or the sweep scripts. No benefit to shipping it in the build context.
# Post-v2.0.0 the canonical seed tree is `results/seeds/<campaign>/...`;
# the 14 legacy top-level directories (results/raw/, results/cloud/,
# results/q3329/, results/cliff_500bit/, etc.) were deleted in the
# symlink-drop migration and no longer appear in fresh checkouts.
results/seeds/
results/backups/
results/analysis/

# Append-only audit chain / path translation table — not used in the image
results/clamp_events.jsonl
results/seed_path_crosswalk.csv

# Rendered paper artifacts — regenerated from LaTeX source / analysis scripts
paper/*.pdf
paper/*.html
paper/*.png
paper/latex/figs/*.png
analysis/figures/*.png
figures/*.png

# Runtime / local caches / VCS
logs/
_archives/
.git/
.github/
**/__pycache__/
**/*.pyc
**/*.pyo
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Claude Code local config + caveman backups — not for the image
.claude/
CLAUDE.md
*.original.md
.tags
tags
.ctags.d/
compile_paper_findings.sh

# Example outputs (generated PNGs)
examples/output/

