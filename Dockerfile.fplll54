FROM python:3.12.3-bookworm

# fplll 5.4.x sensitivity variant: source-build fplll 5.4.5 and fpylll
# 0.6.0 against it, in place of the fpylll 0.6.4 wheel (which bundles
# fplll 5.5.0) used by the main Dockerfile. Purpose: reviewer-defensible
# check that paper results are not fplll-version-sensitive. Runs the same
# sweep entry points as Dockerfile, so only the GSO/BKZ C++ backend
# differs between this image and Dockerfile.

RUN apt-get update && apt-get install -y --no-install-recommends \
        libmpfr-dev \
        libgmp-dev \
        build-essential \
        autoconf \
        automake \
        libtool \
        libtool-bin \
        pkg-config \
        git \
    && rm -rf /var/lib/apt/lists/*

# -- Build fplll 5.4.5 from source ------------------------------------------
RUN git clone --depth 1 --branch 5.4.5 https://github.com/fplll/fplll.git /tmp/fplll \
    && cd /tmp/fplll \
    && ./autogen.sh \
    && ./configure --prefix=/usr/local --disable-static \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && rm -rf /tmp/fplll

# -- Build fpylll 0.6.0 from sdist against the system fplll 5.4.5 ----------
# fpylll 0.6.0 sdist targets fplll 5.4.x. Cython>=3 per its setup.cfg.
RUN pip install --no-cache-dir \
        "Cython>=3.0,<3.1" \
        "cysignals==1.11.4" \
        "numpy<2.0"
RUN pip install --no-cache-dir --no-binary=:all: fpylll==0.6.0

# Non-root runtime — match host UID/GID so bind-mounted volumes don't
# produce root-owned host files (Incident #32 was triggered specifically
# by these fplll-sensitivity Docker builds; backlog
# /mnt/hgfs/Research/backlog/2026-04-20_v3_dockerfile_scope.md §8).
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if ! getent group ${HOST_GID} >/dev/null; then \
        groupadd -g ${HOST_GID} runner; \
    fi && \
    if ! getent passwd ${HOST_UID} >/dev/null; then \
        useradd --no-log-init -u ${HOST_UID} -g ${HOST_GID} -m runner; \
    fi

WORKDIR /experiment
COPY --chown=${HOST_UID}:${HOST_GID} scripts/ scripts/
RUN chown -R ${HOST_UID}:${HOST_GID} /experiment

# Verify at build time that the backend really is fplll 5.4.5 (still
# as root so /usr/local/lib reads succeed without group fuss).
RUN python3 -c "import fpylll; print('fpylll version:', fpylll.__version__)" \
    && find / -name 'libfplll.so*' 2>/dev/null \
    && (strings /usr/local/lib/libfplll.so* 2>/dev/null | grep -oE 'fplll-[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)

USER ${HOST_UID}:${HOST_GID}

CMD ["python3", "-c", "import fpylll; print('fpylll 0.6.0 against fplll 5.4.5 ready')"]
