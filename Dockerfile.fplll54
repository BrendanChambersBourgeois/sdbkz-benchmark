# Digest-pinned per ADR-004; see Dockerfile (main) for the digest
# resolution provenance.
FROM python:3.12.3-bookworm@sha256:25dee7f137aa44c4962d21346385737eb81954b6f06f519fcc348b67f6483d3c

# fplll 5.4.x sensitivity variant: source-build fplll 5.4.5 and fpylll
# 0.6.0 against it, in place of the fpylll 0.6.4 wheel (which bundles
# fplll 5.5.0) used by the main Dockerfile. Purpose: reviewer-defensible
# check that paper results are not fplll-version-sensitive. Runs the same
# sweep entry points as Dockerfile, so only the GSO/BKZ C++ backend
# differs between this image and Dockerfile.
#
# Intentional omissions vs Dockerfile (main): scipy + matplotlib + pytest.
# This image's only job is to run the sweep + emit per-seed JSONs; figure
# regen + the test suite run from the main image so a single matplotlib
# version produces all paper figures. Adding render-touching deps here
# would expand the byte-identity surface for no scientific gain.

# Apt pinned via snapshot.debian.org (ADR-004) — see Dockerfile.
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20240614T000000Z/\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/20240614T000000Z/\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        > /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        libmpfr-dev \
        libgmp-dev \
        build-essential \
        autoconf \
        automake \
        libtool \
        libtool-bin \
        pkg-config \
        git \
    && rm -rf /var/lib/apt/lists/*

# -- Build fplll 5.4.5 from source ------------------------------------------
RUN git clone --depth 1 --branch 5.4.5 https://github.com/fplll/fplll.git /tmp/fplll \
    && cd /tmp/fplll \
    && ./autogen.sh \
    && ./configure --prefix=/usr/local --disable-static \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && rm -rf /tmp/fplll

# -- Build fpylll 0.6.0 from sdist against the system fplll 5.4.5 ----------
# fpylll 0.6.0 sdist targets fplll 5.4.x. Cython>=3 per its setup.cfg.
# The (cysignals, numpy) pair is intentionally older than the main
# Dockerfile's (1.12.6, 2.4.4): fpylll 0.6.0 predates numpy 2.x and
# its sdist `setup.py` declares `numpy<2`. Pinning the exact 1.26.4
# release (last numpy 1.x, ABI-stable against fpylll 0.6.0) matches
# ADR-004's "exact, not loose" reproducibility discipline — the
# range pin `numpy<2.0` would float across the snapshot.debian.org
# apt mirror's lifetime and silently swap ABI behaviour underneath
# a sensitivity comparison.
RUN pip install --no-cache-dir \
        "Cython>=3.0,<3.1" \
        cysignals==1.11.4 \
        numpy==1.26.4
RUN pip install --no-cache-dir --no-binary=:all: fpylll==0.6.0

# Non-root runtime — match host UID/GID so bind-mounted volumes don't
# produce root-owned host files (Incident #32 was triggered specifically
# by these fplll-sensitivity Docker builds; backlog
# /mnt/hgfs/Research/backlog/2026-04-20_v3_dockerfile_scope.md §8).
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if ! getent group ${HOST_GID} >/dev/null; then \
        groupadd -g ${HOST_GID} runner; \
    fi && \
    if ! getent passwd ${HOST_UID} >/dev/null; then \
        useradd --no-log-init -u ${HOST_UID} -g ${HOST_GID} -m runner; \
    fi

WORKDIR /experiment
COPY --chown=${HOST_UID}:${HOST_GID} scripts/ scripts/
RUN chown -R ${HOST_UID}:${HOST_GID} /experiment

# Verify at build time that the backend really is fplll 5.4.5 (still
# as root so /usr/local/lib reads succeed without group fuss).
RUN python3 -c "import fpylll; print('fpylll version:', fpylll.__version__)" \
    && find / -name 'libfplll.so*' 2>/dev/null \
    && (strings /usr/local/lib/libfplll.so* 2>/dev/null | grep -oE 'fplll-[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)

USER ${HOST_UID}:${HOST_GID}

CMD ["python3", "-c", "import fpylll; print('fpylll 0.6.0 against fplll 5.4.5 ready')"]
